{
	"name": "@revia/workspace",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "bun run build:core && bun run build:integration",
		"build:core": "bun run --cwd ./packages/core build",
		"build:integration": "vite build --config vite.integration.config.ts",
		"dev": "bun run build:core && vite --config vite.integration.config.ts",
		"lint": "eslint",
		"typecheck": "tsc --noEmit"
	},
	"overrides": {
		"nanoid": "^3.3.18"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.3.0",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.2.0",
		"eslint": "^10.8.1",
		"happy-dom": "^20.11.2",
		"typescript": "^5.9.3",
		"vite": "^8.2.2"
	}
}
