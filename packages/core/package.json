{
	"name": "@revia/core",
	"version": "0.0.0",
	"type": "module",
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p ./tsconfig.build.json && bun ./scripts/fix-import-specifiers.ts",
		"dev": "tsc -p ./tsconfig.build.json --watch",
		"typecheck": "tsc -p ./tsconfig.json --noEmit"
	},
	"publishConfig": {
		"access": "public"
	}
}
